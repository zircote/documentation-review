---
# Documentation Review Plugin Configuration
# Copy this file to: .claude/documentation-review.local.md

# Documentation paths to scan (default: auto-detect)
doc_paths:
  - docs/
  - README.md
  - "*.md"

# Files/patterns to ignore
ignore:
  - "**/node_modules/**"
  - "**/vendor/**"
  - "**/.git/**"
  - "**/dist/**"
  - "**/build/**"
  - "CHANGELOG.md"

# Documentation standards
standards:
  require_description: true      # First paragraph should describe purpose
  max_heading_depth: 4           # Avoid h5, h6 for readability
  require_code_examples: false   # Not all docs need code
  check_links: true              # Validate internal links
  check_spelling: false          # Disabled by default (can be slow)

# API documentation settings
api_docs:
  openapi_path: null             # Auto-detect: openapi.yaml, swagger.json, etc.
  asyncapi_path: null            # Auto-detect if present
  generate_from_code: false      # Opt-in feature
  # Language doc toolchains (uncomment the one matching your project)
  # rustdoc:
  #   enabled: true
  #   build_command: "cargo doc --no-deps --all-features"
  #   crates: []                 # List specific crates, or empty for all
  #   warn_missing_docs: true
  # godoc:
  #   enabled: true
  #   packages:
  #     - ./...
  # sphinx:
  #   enabled: true
  #   build_command: "sphinx-build -b html docs/ docs/_build/"
  #   docstring_style: google    # google | numpy | rst
  # typedoc:
  #   enabled: true
  #   build_command: "npx typedoc"
  #   entry_points:
  #     - src/index.ts
  # javadoc:
  #   enabled: true
  #   build_command: "./gradlew javadoc"
  # dokka:
  #   enabled: true
  #   build_command: "./gradlew dokkaHtml"

# Static site generator integration
site_generator:
  type: auto                     # auto, mkdocs, sphinx, docusaurus, astro
  config_path: null              # Auto-detect

# Diátaxis framework settings (enabled at standard strictness by default)
diataxis:
  enabled: true                    # Default: true — set false to opt out
  strictness: strict               # Default: strict — advisory | standard | strict
  require_frontmatter: true        # Require diataxis_type in doc frontmatter
  doc_paths: []                    # Paths to scan (empty = use top-level doc_paths)
  quadrant_directories:            # Optional: organize docs by quadrant directory
    tutorials: null                # e.g. docs/tutorials/
    how-to: null                   # e.g. docs/guides/
    reference: null                # e.g. docs/reference/
    explanation: null              # e.g. docs/explanation/

# Output preferences
output:
  verbosity: normal              # minimal, normal, detailed
  format: markdown               # markdown, json
---

# Project Documentation Notes

Add any project-specific documentation context, conventions, or notes here.
This section is available to the documentation review agents for additional context.

## Documentation Conventions

- Document conventions specific to this project
- Note any special terminology or naming patterns
- Reference style guides if applicable

## Areas of Focus

- List areas that need documentation attention
- Note any known documentation gaps
- Highlight critical documentation dependencies
